# =============================================================================
# store box configuration — copy to .env and fill in.
# =============================================================================
# .env is gitignored. Two files are rendered from it by ./render.sh:
# connector.toml and nginx/conf.d/node.conf.

# ── Required ─────────────────────────────────────────────────────────────────

# The zone the box's hostnames live under. Two A-records must point here:
#   proxy.ario.${DOMAIN}   the paid ILP edge
#   dvm.${DOMAIN}          health
DOMAIN=devnet.toonprotocol.dev

# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=you@example.com

# Leave at 1 until DNS resolves to this box, then set 0 and re-run
# ./init-letsencrypt.sh. Staging certificates are untrusted by browsers but
# do not burn the production rate limit while you are still wiring DNS up.
LETSENCRYPT_STAGING=1

# The store's Nostr identity — 64 hex characters, NOT a mnemonic.
#   openssl rand -hex 32
STORE_NOSTR_SECRET_KEY=

# Gates the connector's /metrics and redeem endpoints. Any random secret:
#   openssl rand -hex 32
# Rotate it by changing it here, re-running ./render.sh, and restarting the
# connector (the config is read once at startup).
OPERATOR_BEARER_TOKEN=

# The Nostr pubkey (64 hex) permitted to sign operator writes.
OPERATOR_WRITE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# An existing certificate lineage to keep using, if this box already has one
# filed under a different name. Defaults to proxy.ario.${DOMAIN}.
# CERT_NAME=

# A funded Arweave JWK, base64-encoded. Without it the store uploads on the
# unauthenticated free tier, which caps a single upload at 100KB.
STORE_ARWEAVE_JWK_B64=

# Advertised price per job, in the settlement token's smallest unit. Keep it
# consistent with the [[routes]] price in connector.toml.template.
FEE_PER_JOB=10

LOG_LEVEL=info

# ── Optional job kinds ───────────────────────────────────────────────────────
# Each kind stays unregistered while its variable is empty. kind:5094 (Arweave
# blob storage) is always on and needs nothing here.

# kind:5095 — ArNS brokered buy. A Solana key holding the name-buying float.
ARNS_DVM_SOLANA_SECRET_KEY=
ARNS_NETWORK=devnet

# kind:5096 — Solana gas station. A DEDICATED fee-payer key, separate from the
# ArNS float above: this one co-signs other people's transactions.
GAS_STATION_SOLANA_SECRET_KEY=
# Optionally let it co-sign TOON payment-channel deposit/close/settle. Read the
# current program id from the live announce; it rotates with the connector's
# deployment.
GAS_STATION_CHANNEL_PROGRAM_ID=

# kind:5098 — EVM gas station (ERC-2771 meta-transactions). A JSON array of
# {chainId, rpcUrl, forwarderAddress, tokenNetworkAddress, relayerPrivateKey}.
# Adding a chain is an entry here, not a code change. Carries private keys.
EVM_GAS_STATION_CONFIG_JSON=
EVM_GAS_STATION_QUOTE_TTL_MS=
EVM_GAS_STATION_MAX_GAS=
