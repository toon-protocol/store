# =============================================================================
# TOON store — NIP-90 kind:5094 Arweave blob storage
# =============================================================================
# A payment-oblivious HTTP backend. It listens on 3300 for POST /store, uploads
# the blob to Arweave via Turbo, and answers with the transaction id. The
# connector runs in FRONT of it as the payment proxy and reverse-proxies to it
# (RouteTermination); this process contains no ILP or payment logic at all.
#
#   3300 — POST /store, the job backend the connector proxies to
#   3400 — health endpoint (Hono)
#
# Build from the repo root:
#   docker build -f Dockerfile.store -t ghcr.io/toon-protocol/store:dev .
#
# ── One source of truth for versions ─────────────────────────────────────────
# The runtime stage installs the production dependency closure straight from
# package.json + pnpm-lock.yaml. It does not hand-copy module trees and does
# not re-pin any package, so a dependency's version is written down exactly
# once, in package.json, and `pnpm install` is what keeps the lockfile honest.
# esbuild bundles src/ ONLY (`packages: 'external'`), so every dependency —
# including the ones reached through a dynamic or variable import
# (@ardrive/turbo-sdk, arweave, @ar.io/sdk, @solana/kit) — resolves from that
# installed node_modules at runtime.
# =============================================================================

# -- Stage 1: build the bundle ------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@8.15.9 --activate

# Manifests first, so a source-only change reuses the install layer.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY tsconfig.json esbuild.config.mjs ./
COPY src/ ./src/
RUN pnpm build

# -- Stage 2: production dependency closure -----------------------------------
FROM node:22-alpine AS deps

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@8.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile --node-linker=hoisted

# Strip what only a compiler or a human reads. Type declarations, source maps
# and package docs are a large share of the installed tree and nothing at
# runtime opens them. Files ONLY -- directory names like test/ and examples/
# are real source in some packages (viem ships actions/test/), so pruning by
# directory name silently breaks module resolution at boot.
RUN find node_modules -type f \( -name "*.d.ts" -o -name "*.d.mts" -o -name "*.d.cts" \
      -o -name "*.map" -o -name "*.md" -o -name "*.markdown" \) -delete

# -- Stage 3: runtime ---------------------------------------------------------
FROM node:22-alpine

WORKDIR /app

# Non-root user, created before anything is copied in.
RUN addgroup -g 1001 toon && \
    adduser -D -u 1001 -G toon toon && \
    mkdir -p /data && \
    chown toon:toon /data

COPY --from=deps --chown=toon:toon /app/node_modules ./node_modules
COPY --from=builder --chown=toon:toon /app/dist/entrypoint-store.js ./entrypoint-store.js

# The bundle is ESM.
RUN echo '{"type":"module"}' > /app/package.json && chown toon:toon /app/package.json

ENV NODE_ENV=production
ENV BLS_PORT=3400
ENV HANDLER_PORT=3300

EXPOSE 3300 3400

# Arweave key material / working data.
VOLUME /data

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget -q --spider http://localhost:${BLS_PORT}/health || exit 1

USER toon
CMD ["node", "/app/entrypoint-store.js"]
